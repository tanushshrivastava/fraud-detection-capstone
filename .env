# Global environment configuration
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
STACK_SUFFIX=daniel

# SageMaker configuration
SAGEMAKER_EXECUTION_ROLE_NAME=AmazonSageMaker-ExecutionRole
SAGEMAKER_EXECUTION_ROLE_ARN=arn:aws:iam::{ACCOUNT_ID}:role/AmazonSageMaker-ExecutionRole

# Frontend configuration
REACT_APP_API_ID=
REACT_APP_API_REGION=us-east-1
REACT_APP_API_STAGE=prod
REACT_APP_API_URL=https://{REACT_APP_API_ID}.execute-api.{REACT_APP_API_REGION}.amazonaws.com/{REACT_APP_API_STAGE}
